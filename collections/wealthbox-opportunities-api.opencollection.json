{
  "opencollection": "1.0.0",
  "info": {
    "name": "Wealthbox CRM Activity Opportunities API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "ACCESS_TOKEN",
      "value": "{{ACCESS_TOKEN}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Opportunities",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all opportunities",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.crmworkspace.com/v1/opportunities"
          },
          "docs": "List all opportunities"
        },
        {
          "info": {
            "name": "Create an opportunity",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.crmworkspace.com/v1/opportunities",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create an opportunity"
        }
      ]
    }
  ],
  "bundled": true
}