{
  "opencollection": "1.0.0",
  "info": {
    "name": "Wealthbox CRM Activity Notes API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "ACCESS_TOKEN",
      "value": "{{ACCESS_TOKEN}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Notes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all notes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.crmworkspace.com/v1/notes"
          },
          "docs": "List all notes"
        },
        {
          "info": {
            "name": "Create a note",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.crmworkspace.com/v1/notes",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a note"
        }
      ]
    }
  ],
  "bundled": true
}